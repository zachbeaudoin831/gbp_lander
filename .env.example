# Copy this to .env (or export these directly) before running main.py
#
# Get a key at https://console.cloud.google.com/ -- enable the "Places API (New)"
# on the project, then create an API key. Restrict it to that API and (in
# production) to your server's IP, or the Application Restrictions a server-side
# key supports. Do NOT use a browser-restricted key for this -- this script
# calls the API server-side.
GOOGLE_PLACES_API_KEY=your_key_here

# ── campaign kits (no-account funnel) ──────────────────────────────────────
# Backend-only writer for the private `kits` storage bucket (db/009_kits.sql).
SUPABASE_URL=https://api.sendkpi.com
SUPABASE_SERVICE_ROLE_KEY=
# Kit email via resend.com (verify sendkpi.com there first). Leave blank to
# skip the email -- the thank-you page still serves every file.
RESEND_API_KEY=
KIT_FROM_EMAIL=Zach at SendKPI <zach@sendkpi.com>
PUBLIC_SITE_URL=https://sendkpi.com
# Implementation-meeting calendar link, included in the kit email.
BOOKING_URL=
